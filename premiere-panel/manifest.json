{
  "manifestVersion": 5,
  "id": "de.mythenausmittelerde.glorfindel",
  "name": "Glorfindel Bridge",
  "version": "0.3.1",
  "main": "index.html",
  "host": { "app": "premierepro", "minVersion": "25.6.0" },
  "entrypoints": [
    { "type": "panel", "id": "glorfindelPanel", "label": { "default": "Glorfindel Bridge" },
      "minimumSize": { "width": 280, "height": 200 }, "preferredDockedSize": { "width": 320, "height": 260 } }
  ],
  "requiredPermissions": {
    "network": { "domains": "all" },
    "localFileSystem": "request"
  }
}
